{
  "manifest_version": 3,
  "name": "API Indonesia: Libur & Sholat",
  "short_name": "Libur Sholat",
  "version": "1.0.0",
  "description": "Upcoming Indonesian public holidays, cuti bersama and today's prayer times for your city, using your own API Indonesia key.",
  "homepage_url": "https://apiindonesia.id",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Libur & Sholat",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": ["storage"],
  "host_permissions": ["https://use.apiindonesia.id/*"]
}
